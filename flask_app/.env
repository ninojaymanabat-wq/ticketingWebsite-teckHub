# ==================== DATABASE CONFIGURATION ====================
# Database URI - SQLite for development, PostgreSQL for production
SQLALCHEMY_DATABASE_URI=sqlite:///ticketing.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

